# Node
TZ=Europe/Paris
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Account area (temporarily disabled: the app is in open access)
AUTH_ENABLED=false

# Frontend map — OpenStreetMap raster tiles, no token required.
# The public openstreetmap.org tile service is fine for development but its
# usage policy rules out a high-traffic deployment: point this at your own or a
# commercial tile server before scaling up.
VITE_APP_NAME=Limopti
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Mobility data
GTFS_TCL_URL=https://www.pigma.org/public/opendata/nouvelle_aquitaine_mobilites/publication/ca_limoges_metropole-aggregated-gtfs.zip
JOURNEY_PLANNER=embedded

# Database
DATABASE_URL=postgres://app:app@localhost:5432/limopti

# Session
SESSION_DRIVER=cookie
